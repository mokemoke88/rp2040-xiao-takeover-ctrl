; SPDX-License-Identifier: MIT
;
; LB / RB の2ピンをまとめて監視する、安定待ち方式のチャタリング除去(docs/spec.md 4 章)。
;
; ピンと値:
;   in_base = RB(GPIO3)、in_base + 1 = LB(GPIO4)。`in pins, 2` で bit0 = RB、bit1 = LB の 2 ビットを読む。
;   生の値は「押下 = 0、離し = 1」(プルアップ + 押すと GND)。反転は CPU 側で行う。
;
; レジスタの使い方:
;   X   確定済みの状態(最後に push した値)。起動時は CPU が pio_sm_exec で 0b100(= 4)を入れる。
;       ピンから読める値は 0〜3 なので必ず「変化あり」になり、起動後の最初の push は、ボタンが押されて
;       いてもいなくても、起動時の(除去済みの)状態になる。CPU はこれを起動時の状態として受け取る
;   Y   今読んだ値
;   ISR ピンを読むための一時置き場。毎回 `mov isr, null` で 0 にしてから `in pins, 2` で読む
;       (ISR は左シフト設定なので、0 にしておけば読んだ 2 ビットがそのまま下位 2 ビットに入る)
;   OSR 読み直しの間、変化前の確定値を退避しておく場所(TX FIFO は使わないので空いている)
;
; ループカウンタに使えるレジスタが残らないため、読み直しはループにせず 5 回分を展開して書いている。
;
; 2 ピンを 1 つの SM でまとめて見ることの性質:
;   2 ビットをまとめて比較するので、片方のピンが約 20 ms より短い周期で変化し続けると(接触不良など)、
;   読み直しのたびに不一致になり、もう片方のピンの変化もその間は確定しない(push されない)。
;   届かないのは「変化」なので、出力は最後に確定した状態のまま動かない。新たなトグルやパルスが
;   起きる方向には働かないので、危険側ではない。
;   (読み取りは一定間隔の標本化なので、ノイズの周期が読み直し間隔とちょうど同期している場合は、
;   毎回同じ値が読めて「安定」とみなすことがある。これは安定待ち方式一般の限界)
;
; なぜ `mov y, pins` を使わないか:
;   RP2040 の PIO では、`mov` の転送元に pins を指定すると in_base から始まる 32 本すべてのピンを読む
;   (`in` と違ってビット数を指定できず、読む本数を 2 本に絞る設定も RP2040 には無い)。LB / RB 以外の
;   ピンの値が混ざって比較が壊れるので、ビット数を指定できる `in pins, 2` を使う。
;
; 除去時間(T_DEBOUNCE)の計算:
;   SM のクロックは CLOCK_HZ = 4000 Hz(1 サイクル = 0.25 ms)。button_input.c で clk_sys から分周比を計算する。
;   各命令は 1 サイクル + 遅延指定([n])サイクルかかる。
;   - 待機中の監視ループ(アドレス 1〜4)は 4 命令 = 4 サイクル = 1 ms ごとにピンを読む
;   - 変化を見つけた読み取り(アドレス 2 の in)をサイクル 0 とすると、その後の
;       mov y / jmp / mov osr / mov x / mov isr [12] が 1+1+1+1+13 = 17 サイクルを使うので、
;       1 回目の読み直し(アドレス 8 の in)はサイクル 18(4.5 ms 後)
;   - 以降は in の後の mov y / jmp / mov isr [12] が 1+1+13 = 15 サイクルを使うので、
;       読み直しの間隔は 16 サイクル(4 ms)
;   - 5 回目の読み直しは変化検出から 18 + 16 * 4 = 82 サイクル = 20.5 ms 後
;   つまり、新しい値が変化検出を含めて 6 回連続(約 20.5 ms)同じだった場合に限り確定して push する。
;   push は変化検出から 85 サイクル(21.25 ms)後。変化そのものの検出には最大 1 ms の遅れがある。
;   除去時間を変えるときは REREAD_DELAY を変える(読み直し間隔 = REREAD_DELAY + 4 サイクル)。
;   起動直後の最初の push は、SM 開始から 1 + 85 = 86 サイクル(21.5 ms)後。
;
; 命令数: 29 / 32

.program debounce

.define public CLOCK_HZ 4000     ; SM のクロック周波数 [Hz]。C 側からは debounce_CLOCK_HZ で参照する
.define public REREAD_DELAY 12   ; 読み直し前の遅延サイクル数(命令の遅延指定の上限は 31)。
                                 ; public にしているのは tools/verification/verify_debounce_pio.py が読むため

; --- 読み直しで値が戻った(ノイズだった)ときの復帰。アドレス 0 ---
revert:
    mov x, osr                   ; 0: 退避しておいた変化前の確定値を X に戻す。そのまま下の監視ループへ進む

; --- 待機中の監視ループ。アドレス 1〜4。.wrap により 4 の次は 1 に戻る(戻りに命令もサイクルも使わない) ---
public start:
.wrap_target
    mov isr, null                ; 1: ISR を 0 にする(シフトカウンタもクリアされる)
    in pins, 2                   ; 2: RB, LB の 2 ピンを読み、ISR の下位 2 ビットに入れる
    mov y, isr                   ; 3: 読んだ値を Y にコピー(jmp で比較できるのは X と Y だけ)
    jmp x!=y changed             ; 4: 確定値と違えば読み直しへ。同じなら .wrap で 1 に戻る
.wrap

; --- 変化を見つけた。候補値が安定しているか 5 回読み直して確かめる ---
changed:
    mov osr, x                   ; 5: 変化前の確定値を OSR に退避(ノイズだったときに戻すため)
    mov x, y                     ; 6: 候補値を X に置く。以降は「X と同じ値が読めるか」を確かめる

    mov isr, null [REREAD_DELAY] ; 7: ISR を 0 にし、REREAD_DELAY サイクル待つ
    in pins, 2                   ; 8: 読み直し 1 回目
    mov y, isr                   ; 9: 読んだ値を Y へ
    jmp x!=y revert              ; 10: 候補値と違えばノイズとして捨てる

    mov isr, null [REREAD_DELAY] ; 11: ISR を 0 にし、REREAD_DELAY サイクル待つ
    in pins, 2                   ; 12: 読み直し 2 回目
    mov y, isr                   ; 13: 読んだ値を Y へ
    jmp x!=y revert              ; 14: 候補値と違えばノイズとして捨てる

    mov isr, null [REREAD_DELAY] ; 15: ISR を 0 にし、REREAD_DELAY サイクル待つ
    in pins, 2                   ; 16: 読み直し 3 回目
    mov y, isr                   ; 17: 読んだ値を Y へ
    jmp x!=y revert              ; 18: 候補値と違えばノイズとして捨てる

    mov isr, null [REREAD_DELAY] ; 19: ISR を 0 にし、REREAD_DELAY サイクル待つ
    in pins, 2                   ; 20: 読み直し 4 回目
    mov y, isr                   ; 21: 読んだ値を Y へ
    jmp x!=y revert              ; 22: 候補値と違えばノイズとして捨てる

    mov isr, null [REREAD_DELAY] ; 23: ISR を 0 にし、REREAD_DELAY サイクル待つ
    in pins, 2                   ; 24: 読み直し 5 回目
    mov y, isr                   ; 25: 読んだ値を Y へ
    jmp x!=y revert              ; 26: 候補値と違えばノイズとして捨てる

    push block                   ; 27: 確定。ISR(= 候補値)を RX FIFO に入れる。FIFO が満杯なら空くまで待つ。
                                 ;     push 後の ISR は 0 になる。X は候補値のままなので、これが新しい確定値になる
    jmp start                    ; 28: 監視ループに戻る
